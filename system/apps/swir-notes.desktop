[Desktop Entry]
Type=Application
Name=SWIR Notes / Text Editor
Comment=Edit local UTF-8 text and code files with native SWIR Notes
Exec=/usr/local/bin/swir-notes %f
TryExec=/usr/local/bin/swir-notes
Icon=accessories-text-editor
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;application/json;application/javascript;text/css;text/html;application/xml;text/xml;text/x-python;
StartupNotify=true
StartupWMClass=dev.swir.Notes
