[Desktop Entry]
Type=Application
Name=SWIR Browser
Comment=Browse the web with the native SWIR OS browser
Exec=/usr/local/bin/swir-browser %u
TryExec=/usr/local/bin/swir-browser
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=dev.swir.Browser
