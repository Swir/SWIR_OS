[Desktop Entry]
Type=Application
Name=SWIR Archive Manager
Comment=Inspect and safely extract local archives with native SWIR Archive Manager
Exec=/usr/local/bin/swir-files --archive-manager --archive-open %f
TryExec=/usr/local/bin/swir-files
Icon=package-x-generic
Terminal=false
Categories=Utility;Archiving;
MimeType=application/zip;application/x-tar;application/gzip;application/x-xz;application/x-bzip2;
StartupNotify=true
StartupWMClass=dev.swir.ArchiveManager
