{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.github.io/system/contracts/system-recovery-mode-e2e.schema.json",
  "title": "SWIR System Recovery Mode UEFI E2E 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generatedAt", "distribution", "architecture", "bootPath", "bootTarget", "dedicatedBootEntry",
    "partitionTable", "rootFilesystem", "rootFilesystemLabel", "espFilesystem", "espFilesystemLabel",
    "rootReadOnly", "rootFstabIntegrated", "espFstabIntegrated", "remountServiceMasked",
    "fstabGeneratorDisabledDuringRecovery", "guestNetworkDisabled", "diagnosticsAgentPassed",
    "transactionJournalScanPassed", "automaticFilesystemRepairPerformed", "automaticPackageMutationPerformed",
    "automaticFirmwareMutationPerformed", "bootloaderSha256", "imageSha256", "ovmfSha256",
    "recoveryModeClaim", "filesystemIntegrationClaim", "filesystemRepairClaim", "hardwareQualificationClaim",
    "installerClaim", "passed"
  ],
  "properties": {
    "schema": { "const": "swir.system-recovery-mode-e2e/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "distribution": { "const": "debian-13-trixie" },
    "architecture": { "const": "amd64" },
    "bootPath": { "const": "uefi-systemd-boot-recovery" },
    "bootTarget": { "const": "swir-recovery.target" },
    "dedicatedBootEntry": { "const": "swir-recovery.conf" },
    "partitionTable": { "const": "gpt" },
    "rootFilesystem": { "const": "ext4" },
    "rootFilesystemLabel": { "const": "SWIR_ROOT" },
    "espFilesystem": { "const": "fat32" },
    "espFilesystemLabel": { "const": "SWIR_ESP" },
    "rootReadOnly": { "const": true },
    "rootFstabIntegrated": { "const": true },
    "espFstabIntegrated": { "const": true },
    "remountServiceMasked": { "const": true },
    "fstabGeneratorDisabledDuringRecovery": { "const": true },
    "guestNetworkDisabled": { "const": true },
    "diagnosticsAgentPassed": { "const": true },
    "transactionJournalScanPassed": { "const": true },
    "automaticFilesystemRepairPerformed": { "const": false },
    "automaticPackageMutationPerformed": { "const": false },
    "automaticFirmwareMutationPerformed": { "const": false },
    "bootloaderSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ovmfSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recoveryModeClaim": { "const": true },
    "filesystemIntegrationClaim": { "const": true },
    "filesystemRepairClaim": { "const": false },
    "hardwareQualificationClaim": { "const": false },
    "installerClaim": { "const": false },
    "passed": { "const": true }
  }
}
