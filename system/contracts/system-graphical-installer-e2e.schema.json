{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swir.dev/schema/system-graphical-installer-full-e2e/0.1",
  "title": "SWIR System graphical installer full-path E2E evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "distribution",
    "architecture",
    "firmware",
    "liveUsbTransport",
    "liveImageSha256",
    "installedDiskSha256",
    "gtkWindowCreated",
    "uiSelectedStableTarget",
    "uiPreviewReadOnly",
    "uiWrongTokenBlocked",
    "uiIdentityReviewPassed",
    "uiTriggeredPrivilegedInstall",
    "sourceMediaTargetRejected",
    "installedUserCreated",
    "installedLocaleVerified",
    "installedKeyboardVerified",
    "installedTimezoneVerified",
    "passwordStoredInEvidence",
    "sourceUsbDetachedBeforeInstalledBoot",
    "installedDiskBooted",
    "installedGraphicalSessionPassed",
    "installedPersistencePassed",
    "physicalHardwareQualificationClaim",
    "secureBootClaim"
  ],
  "properties": {
    "schema": { "const": "swir.graphical-installer-full-e2e/0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "distribution": { "const": "debian-13-trixie" },
    "architecture": { "const": "amd64" },
    "firmware": { "const": "uefi-ovmf" },
    "liveUsbTransport": { "const": "qemu-usb-storage" },
    "liveImageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "installedDiskSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gtkWindowCreated": { "const": true },
    "uiSelectedStableTarget": { "const": true },
    "uiPreviewReadOnly": { "const": true },
    "uiWrongTokenBlocked": { "const": true },
    "uiIdentityReviewPassed": { "const": true },
    "uiTriggeredPrivilegedInstall": { "const": true },
    "sourceMediaTargetRejected": { "const": true },
    "installedUserCreated": { "const": true },
    "installedLocaleVerified": { "const": true },
    "installedKeyboardVerified": { "const": true },
    "installedTimezoneVerified": { "const": true },
    "passwordStoredInEvidence": { "const": false },
    "sourceUsbDetachedBeforeInstalledBoot": { "const": true },
    "installedDiskBooted": { "const": true },
    "installedGraphicalSessionPassed": { "const": true },
    "installedPersistencePassed": { "const": true },
    "physicalHardwareQualificationClaim": { "const": false },
    "secureBootClaim": { "const": false }
  }
}
